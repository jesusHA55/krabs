[Unit]
Description=Krabs broker-paper for Larry slow+medium
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
WorkingDirectory=%h/Krabs
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Krabs/scripts/run_broker_paper.sh
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
