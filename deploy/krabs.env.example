# Krabs secrets -- copy to /etc/krabs/krabs.env and chmod 600 root:krabs.
# NEVER commit this file. NEVER put keys in krabs.toml.
#
# Alpaca: use PAPER keys first (they are different from live keys). Restrict the
# key to trading (no funding/withdrawal) and, where available, IP-allowlist it.

ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
